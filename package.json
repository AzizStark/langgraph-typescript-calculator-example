{
  "name": "nodestarter",
  "version": "1.0.0",
  "description": "",
  "main": "dist/index.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && esbuild src/index.ts --bundle --outfile=dist/bundle.js --platform=node --format=cjs --minify --sourcemap",
    "build:browser": "npm run typecheck && esbuild src/index.ts --bundle --outfile=dist/bundle.js --platform=browser --format=iife --minify --sourcemap",
    "start": "node dist/bundle.js",
    "dev": "nodemon --exec ts-node src/index.ts",
    "test": "echo \"Error: no test specified\" && exit 1",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "clean": "rm -rf dist"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^22.14.1",
    "esbuild": "^0.25.2",
    "nodemon": "^3.1.9",
    "prettier": "^3.5.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@aws-sdk/credential-provider-node": "^3.787.0",
    "@langchain/community": "^0.3.41",
    "@langchain/core": "^0.3.45",
    "@langchain/langgraph": "^0.2.65",
    "@langchain/openai": "^0.5.6",
    "@smithy/eventstream-codec": "^2.2.0",
    "dotenv": "^16.5.0",
    "eventsource-parser": "^3.0.1",
    "langchain": "^0.3.23",
    "uuid": "^11.1.0"
  }
}
